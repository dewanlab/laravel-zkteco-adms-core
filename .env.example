# -----------------------------------------------------------------------------
# Laravel ZKTeco ADMS Core Configuration
# -----------------------------------------------------------------------------

# Table prefix for package migrations and Eloquent models (default: zkteco_)
ZKTECO_ADMS_TABLE_PREFIX=zkteco_

# ADMS HTTP protocol routing
ZKTECO_ADMS_ROUTE_PREFIX=iclock
ZKTECO_ADMS_ROUTE_DOMAIN=

# Device handshake configuration (GET OPTION FROM: <SN>)
ZKTECO_ADMS_REALTIME=1
ZKTECO_ADMS_DELAY=30
ZKTECO_ADMS_ERROR_DELAY=60
ZKTECO_ADMS_TRANS_INTERVAL=1
ZKTECO_ADMS_TRANS_TIMES="00:00;14:05"
ZKTECO_ADMS_TRANS_FLAG="1111111111"
ZKTECO_ADMS_ENCRYPT=0
ZKTECO_ADMS_TIMEZONE=UTC

# Dedicated package protocol logging
ZKTECO_ADMS_LOGGING_ENABLED=true
ZKTECO_ADMS_LOG_CHANNEL=zkteco-adms
ZKTECO_ADMS_LOG_LEVEL=debug
ZKTECO_ADMS_LOG_DAYS=14